# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Shown in the header and in AI-written messages
NEXT_PUBLIC_SCHOOL_NAME=Your School Name

# Used for "today" in attendance and dashboard (default Asia/Kolkata)
SCHOOL_TZ=Asia/Kolkata

# Optional: AI features. Without a key the app still works and
# uses simple built-in text templates instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# REQUIRED for creating staff/parent logins from the Users page.
# Supabase -> Project Settings -> API -> service_role key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Library defaults
LIBRARY_LOAN_DAYS=14
LIBRARY_FINE_PER_DAY=1
